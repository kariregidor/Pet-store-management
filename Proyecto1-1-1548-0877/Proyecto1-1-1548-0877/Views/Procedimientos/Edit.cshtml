@model Proyecto1_1_1548_0877.Models.Procedimientos


@{
    ViewData["Title"] = "Editar Procedimiento";
}

<h1>Editar Procedimiento</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- ID -->
            <div class="form-group">
                <label asp-for="Id" class="control-label"></label>
                <input asp-for="Id" class="form-control" readonly />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>

            <!-- Cliente -->
            <div class="form-group">
                <label asp-for="IdCliente" class="control-label"></label>
                <select asp-for="IdCliente" class="form-control" asp-items="ViewBag.Clientes" id="IdCliente">
                    <option value="">-- Seleccione cliente --</option>
                </select>
                <span asp-validation-for="IdCliente" class="text-danger"></span>
            </div>

            <!-- Mascota -->
            <div class="form-group">
                <label asp-for="MascotaId" class="control-label"></label>
                <select asp-for="MascotaId" class="form-control" id="MascotaId" asp-items="ViewBag.Mascotas">
                    <option value="">-- Seleccione mascota --</option>
                </select>
                <span asp-validation-for="MascotaId" class="text-danger"></span>
            </div>

            <!-- Campo oculto para recordar la mascota seleccionada -->
            <input type="hidden" id="MascotaSeleccionada" value="@Model.MascotaId" />

            <!-- Tabla de Tipos de Procedimiento -->
            <h4>Tipos de Procedimiento</h4>
            <table class="table table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Tipo</th>
                        <th>Descripción</th>
                        <th>Precio Base (₡)</th>
                        <th>Seleccionar</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Consulta</td>
                        <td>Consulta de mascota</td>
                        <td>15000</td>
                        <td>
                            <input type="radio" name="TipoProcedimiento" value="Consulta" data-precio="15000" class="tipo-procedimiento" />
                        </td>
                    </tr>
                    <tr>
                        <td>Consulta en horario especial</td>
                        <td>Consulta después de las 18:00 hrs o fines de semana/feriados</td>
                        <td>17000</td>
                        <td>
                            <input type="radio" name="TipoProcedimiento" value="ConsultaHorarioEspecial" data-precio="17000" class="tipo-procedimiento" />
                        </td>
                    </tr>
                    <tr>
                        <td>Castración 0-5 kg</td>
                        <td>Mascota castrada con peso 0-5 kg</td>
                        <td>35000</td>
                        <td>
                            <input type="radio" name="TipoProcedimiento" value="Castracion_0_5kg" data-precio="35000" class="tipo-procedimiento" />
                        </td>
                    </tr>
                    <tr>
                        <td>Castración 5-10 kg</td>
                        <td>Mascota castrada con peso 5-10 kg</td>
                        <td>45000</td>
                        <td>
                            <input type="radio" name="TipoProcedimiento" value="Castracion_5_10kg" data-precio="45000" class="tipo-procedimiento" />
                        </td>
                    </tr>
                    <tr>
                        <td>Castración 10-20 kg</td>
                        <td>Mascota castrada con peso 10-20 kg</td>
                        <td>55000</td>
                        <td>
                            <input type="radio" name="TipoProcedimiento" value="Castracion_10_20kg" data-precio="55000" class="tipo-procedimiento" />
                        </td>
                    </tr>
                    <tr>
                        <td>Castración 20-30 kg</td>
                        <td>Mascota castrada con peso 20-30 kg</td>
                        <td>80000</td>
                        <td>
                            <input type="radio" name="TipoProcedimiento" value="Castracion_20_30kg" data-precio="80000" class="tipo-procedimiento" />
                        </td>
                    </tr>
                    <tr>
                        <td>Castración 30-50 kg</td>
                        <td>Mascota castrada con peso 30-50 kg</td>
                        <td>100000</td>
                        <td>
                            <input type="radio" name="TipoProcedimiento" value="Castracion_30_50kg" data-precio="100000" class="tipo-procedimiento" />
                        </td>
                    </tr>
                    <tr>
                        <td>Cirugía menor</td>
                        <td>Costo por kilo de peso del paciente</td>
                        <td>15000</td>
                        <td>
                            <input type="radio" name="TipoProcedimiento" value="CirugiaMenor" data-precio="15000" class="tipo-procedimiento" data-por-kg="true" />
                        </td>
                    </tr>
                    <tr>
                        <td>Cirugía mayor</td>
                        <td>Costo por kilo de peso del paciente</td>
                        <td>25000</td>
                        <td>
                            <input type="radio" name="TipoProcedimiento" value="CirugiaMayor" data-precio="25000" class="tipo-procedimiento" data-por-kg="true" />
                        </td>
                    </tr>
                    <tr>
                        <td>Grooming pequeña</td>
                        <td>Grooming completo de mascota pequeña</td>
                        <td>15000</td>
                        <td>
                            <input type="radio" name="TipoProcedimiento" value="Grooming_Pequeña" data-precio="15000" class="tipo-procedimiento" />
                        </td>
                    </tr>
                    <tr>
                        <td>Grooming mediana</td>
                        <td>Grooming completo de mascota mediana</td>
                        <td>20000</td>
                        <td>
                            <input type="radio" name="TipoProcedimiento" value="Grooming_Mediana" data-precio="20000" class="tipo-procedimiento" />
                        </td>
                    </tr>
                    <tr>
                        <td>Grooming grande</td>
                        <td>Grooming completo de mascota grande</td>
                        <td>25000</td>
                        <td>
                            <input type="radio" name="TipoProcedimiento" value="Grooming_Grande" data-precio="25000" class="tipo-procedimiento" />
                        </td>
                    </tr>
                    <tr>
                        <td>Grooming extra grande</td>
                        <td>Grooming completo de mascota extra grande</td>
                        <td>35000</td>
                        <td>
                            <input type="radio" name="TipoProcedimiento" value="Grooming_ExtraGrande" data-precio="35000" class="tipo-procedimiento" />
                        </td>
                    </tr>
                    <tr>
                        <td>Vacunas anuales</td>
                        <td>Vacunas anuales de mascota</td>
                        <td>40000</td>
                        <td>
                            <input type="radio" name="TipoProcedimiento" value="VacunasAnuales" data-precio="40000" class="tipo-procedimiento" />
                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- Peso -->
            <div class="form-group">
                <label asp-for="Peso" class="control-label"></label>
                <input asp-for="Peso" class="form-control" id="Peso" type="number" step="0.01" />
                <span asp-validation-for="Peso" class="text-danger"></span>
            </div>

            <!-- Precio Base -->
            <div class="form-group">
                <label asp-for="PrecioBase" class="control-label"></label>
                <input asp-for="PrecioBase" class="form-control" readonly id="PrecioBase" />
                <span asp-validation-for="PrecioBase" class="text-danger"></span>
            </div>

            <!-- IVA -->
            <div class="form-group">
                <label asp-for="IVA" class="control-label"></label>
                <input asp-for="IVA" class="form-control" readonly id="IVA" />
            </div>

            <!-- Precio Total -->
            <div class="form-group">
                <label asp-for="PrecioTotal" class="control-label"></label>
                <input asp-for="PrecioTotal" class="form-control" readonly id="PrecioTotal" />
            </div>

            <!-- Estado -->
            <div class="form-group">
                <label asp-for="Estado" class="control-label"></label>
                <select asp-for="Estado" class="form-control" asp-items="ViewBag.EstadoProcedimiento">
                    <option value="">-- Seleccione estado --</option>
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>

            <!-- Botón Guardar -->
            <div class="form-group mt-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-2">
    <a asp-action="IndexProcedimientos" class="btn btn-secondary">Volver a la lista</a>
</div>

@section Scripts {
    <script>
        // =============================
        // CARGAR MASCOTAS DINÁMICAMENTE
        // =============================
        function cargarMascotas(idCliente, mascotaSeleccionada) {
            if (!idCliente) {
                $('#MascotaId').empty().append('<option value="">-- Seleccione mascota --</option>');
                return;
            }

            $.getJSON('/Procedimientos/GetMascotasByCliente', { idCliente: idCliente }, function (mascotas) {
                var $select = $('#MascotaId');
                $select.empty();
                $select.append('<option value="">-- Seleccione mascota --</option>');

                $.each(mascotas, function (i, mascota) {
                    var option = $('<option>', {
                        value: mascota.value,
                        text: mascota.text
                    });
                    if (mascotaSeleccionada && mascota.value == mascotaSeleccionada) {
                        option.prop('selected', true);
                    }
                    $select.append(option);
                });
            });
        }

        $(document).ready(function () {
            var clienteId = $('#IdCliente').val();
            var mascotaSeleccionada = $('#MascotaSeleccionada').val();

            // 🔹 Cargar mascotas al cargar la página (modo edición)
            cargarMascotas(clienteId, mascotaSeleccionada);

            // 🔹 Cargar mascotas al cambiar de cliente
            $('#IdCliente').change(function () {
                var nuevoClienteId = $(this).val();
                cargarMascotas(nuevoClienteId, null);
            });

            // =============================
            // CÁLCULO DE PRECIOS
            // =============================
            function calcularPrecios() {
                var precioBase = 0;
                var peso = parseFloat($('#Peso').val()) || 0;
                var radioSeleccionado = $('input[name="TipoProcedimiento"]:checked');

                if (radioSeleccionado.length > 0) {
                    var precioBaseProcedimiento = parseFloat(radioSeleccionado.data('precio')) || 0;
                    var esPorKg = radioSeleccionado.data('por-kg') === true;

                    if (esPorKg && peso > 0) {
                        precioBase = precioBaseProcedimiento * peso;
                    } else {
                        precioBase = precioBaseProcedimiento;
                    }
                }

                var iva = precioBase * 0.13;
                var precioTotal = precioBase + iva;

                $('#PrecioBase').val(precioBase.toFixed(2));
                $('#IVA').val(iva.toFixed(2));
                $('#PrecioTotal').val(precioTotal.toFixed(2));
            }

            $('.tipo-procedimiento').on('change', calcularPrecios);
            $('#Peso').on('input', calcularPrecios);

            var tipoProcedimientoActual = '@Model.TipoProcedimiento';
            if (tipoProcedimientoActual) {
                $('input[name="TipoProcedimiento"][value="' + tipoProcedimientoActual + '"]').prop('checked', true);
            }

            calcularPrecios();
        });
    </script>
}