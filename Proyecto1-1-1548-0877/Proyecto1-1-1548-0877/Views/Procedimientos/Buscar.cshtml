@model IEnumerable<Proyecto1_1_1548_0877.Models.Procedimientos>

@{
    ViewData["Title"] = "Buscar Procedimientos";
}

<h1>Buscar Procedimientos</h1>

<form asp-action="Buscar" method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-2">
            <input type="number" name="Id" class="form-control" placeholder="Id" />
        </div>
        <div class="col-md-2">
            <input type="number" name="IdCliente" class="form-control" placeholder="Cliente Id" />
        </div>
        <div class="col-md-2">
            <input type="number" name="MascotaId" class="form-control" placeholder="Mascota Id" />
        </div>
        <div class="col-md-2">
            <select name="tipoProcedimiento" class="form-control">
                <option value="">-- Tipo procedimiento --</option>
                @foreach (var esp in ViewBag.TipoProcedimiento ?? new List<SelectListItem>())
                {
                    <option value="@esp.Value">@esp.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <input type="number" step="0.01" name="peso" class="form-control" placeholder="Peso" />
        </div>
        <div class="col-md-2">
            <input type="number" step="0.01" name="PrecioBase" class="form-control" placeholder="Precio base" />
        </div>
        <div class="col-md-2">
            <input type="number" step="0.01" name="IVA" class="form-control" placeholder="IVA" />
        </div>
        <div class="col-md-2">
            <input type="number" step="0.01" name="PrecioTotal" class="form-control" placeholder="Precio total" />
        </div>
        <div class="col-md-2">
            <select name="estadoProcedimiento" class="form-control">
                <option value="">-- Estado --</option>
                @foreach (var esp in ViewBag.EstadoProcedimiento ?? new List<SelectListItem>())
                {
                    <option value="@esp.Value">@esp.Text</option>
                }
            </select>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="IndexProcedimientos" class="btn btn-secondary">Atrás</a>
    </div>
</form>

@if (Model != null && Model.Any())
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Id</th>
                <th>Id Cliente</th>
                <th>Nombre Mascota</th>
                <th>Tipo Procedimiento</th>
                <th>Peso</th>
                <th>Precio Base</th>
                <th>IVA</th>
                <th>Precio Total</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var procedimiento in Model)
            {
                <tr>
                    <td>@procedimiento.Id</td>
                    <td>@procedimiento.IdCliente</td>
                    <td>@(procedimiento.Mascota?.NombreMascota ?? "N/A")</td>
                    <td>@procedimiento.TipoProcedimiento</td>
                    <td>@(procedimiento.Peso?.ToString("F2") ?? "N/A")</td>
                    <td>@procedimiento.PrecioBase.ToString("C")</td>
                    <td>@procedimiento.IVA.ToString("C")</td>
                    <td>@procedimiento.PrecioTotal.ToString("C")</td>
                    <td>@procedimiento.Estado</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@procedimiento.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@procedimiento.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info mt-3">
        No se encontraron procedimientos con los filtros aplicados.
    </div>
}