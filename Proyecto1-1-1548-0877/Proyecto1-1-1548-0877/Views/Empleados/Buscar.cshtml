@model IEnumerable<Proyecto1_1_1548_0877.Models.Empleados>

@{
    ViewData["Title"] = "Buscar Empleados";
}

<h1>Buscar Empleados</h1>

<form asp-action="Buscar" method="get" class="mb-3">
    <div class="row">
        <div class="col-md-2">
            <input type="text" name="cedula" class="form-control" placeholder="Cédula" />
        </div>
        <div class="col-md-2">
            <input type="date" name="fechaNacimiento" class="form-control" />
        </div>
        <div class="col-md-2">
            <input type="date" name="fechaIngreso" class="form-control" />
        </div>
        <div class="col-md-2">
            <input type="number" name="salarioDia" step="0.01" class="form-control" placeholder="Salario x día" />
        </div>
        <div class="col-md-2">
            <input type="date" name="fechaRetiro" class="form-control" />
        </div>
        <div class="col-md-2">
            <select name="tipoEmpleado" class="form-control">
                <option value="">-- Tipo Empleado --</option>
                @foreach (var tipo in ViewBag.TiposEmpleados)
                {
                    <option value="@tipo.Value">@tipo.Text</option>
                }
            </select>
        </div>
    </div>
    <div class="mt-2">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-secondary">Atras</a>
    </div>
</form>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Cédula</th>
            <th>Fecha Nacimiento</th>
            <th>Fecha Ingreso</th>
            <th>Salario x Día</th>
            <th>Fecha Retiro</th>
            <th>Tipo Empleado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var empleado in Model)
        {
            <tr>
                <td>@empleado.Cedula</td>
                <td>@empleado.FechaNacimiento.ToString("dd-MM-yyyy")</td>
                <td>@empleado.FechaIngreso.ToString("dd-MM-yyyy")</td>
                <td>@empleado.SalarioDia</td>
                <td>@(empleado.FechaRetiro.HasValue? empleado.FechaRetiro.Value.ToString("dd-MM-yyyy") : "-")</td>
                <td>@empleado.TipoEmpleado</td>
                <td>
                    <a asp-action="Edit" asp-route-cedula="@empleado.Cedula" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-cedula="@empleado.Cedula" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>