@model Proyecto1_1_1548_0877.Models.Empleados

@{
    ViewData["Title"] = "Actualizar";
}

<h1>Actualizar</h1>

<h4>Empleados</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Cedula" class="control-label"></label>
                <input asp-for="Cedula" class="form-control" readonly />
                <input type="hidden" asp-for="Cedula" />
                <span asp-validation-for="Cedula" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaNacimiento" class="control-label"></label>
                <input asp-for="FechaNacimiento" class="form-control" type="date" />
                <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaIngreso" class="control-label"></label>
                <input asp-for="FechaIngreso" class="form-control" type="date" />
                <span asp-validation-for="FechaIngreso" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SalarioDia" class="control-label"></label>
                <input asp-for="SalarioDia" class="form-control" />
                <span asp-validation-for="SalarioDia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaRetiro" class="control-label"></label>
                <input asp-for="FechaRetiro" class="form-control" type="date" />
                <span asp-validation-for="FechaRetiro" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TipoEmpleado" class="control-label"></label>
                <select asp-for="TipoEmpleado" class="form-control" asp-items="ViewBag.TiposEmpleados">
                    <option value="">-- Seleccione un tipo --</option>
                </select>
                <span asp-validation-for="TipoEmpleado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="IndexEmpleados">Regresar</a>
</div>


