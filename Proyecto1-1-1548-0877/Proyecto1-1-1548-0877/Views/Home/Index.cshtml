@{
    ViewData["Title"] = "Menú Principal";
}

<div class="text-center">
    <h1 class="display-4">Menú Principal</h1>
    <p class="lead">Seleccione una opción:</p>
</div>

<div class="d-flex justify-content-center flex-wrap mt-4">
    <!-- Leer:  visualizar los registros existentes de cada entidad -->
    <!-- Controlador                             VistaIndex                 Boton -->
    <a asp-controller="Empleados" asp-action="IndexEmpleados" class="btn btn-primary m-2 p-3">
        👨‍⚕️ Empleados
    </a>

    <a asp-controller="Mascotas" asp-action="IndexMascotas" class="btn btn-success m-2 p-3">
        🐾 Mascotas
    </a>

    <a asp-controller="Clientes" asp-action="IndexClientes" class="btn btn-info m-2 p-3">
        🧑‍🤝‍🧑 Clientes
    </a>

    <a asp-controller="Procedimientos" asp-action="IndexProcedimientos" class="btn btn-warning m-2 p-3">
        📋 Procedimientos
    </a>

    <a asp-controller="Reportes" asp-action="IndexReportes"
       class="btn m-2 p-3"
       style="background-color:#ff9800; border-color:#e68900; color:black;">
        📋 Reportes
    </a>
</div>



