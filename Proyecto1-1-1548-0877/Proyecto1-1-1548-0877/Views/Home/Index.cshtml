@{
    ViewData["Title"] = "Main Menu";
}

<div class="text-center">
    <h1 class="display-4">Main Menu</h1>
    <p class="lead">Select an option:</p>
</div>

<div class="d-flex justify-content-center flex-wrap mt-4">
    <!-- Read: view the existing records for each entity -->
    <!-- Controller                              IndexView                  Button -->
    <a asp-controller="Employes" asp-action="IndexEmployes" class="btn btn-primary m-2 p-3">
        👨‍⚕️ Employes
    </a>

    <a asp-controller="Pets" asp-action="IndexPets" class="btn btn-success m-2 p-3">
        🐾 Pets
    </a>

    <a asp-controller="Customers" asp-action="IndexCustomers" class="btn btn-info m-2 p-3">
        🧑‍🤝‍🧑 Customers
    </a>

    <a asp-controller="Procedures" asp-action="IndexProcedures" class="btn btn-warning m-2 p-3">
        📋 Procedures
    </a>

    <a asp-controller="Reports" asp-action="IndexReports" class="btn m-2 p-3"
       style="background-color:#ff9800; border-color:#e68900; color:black;">
        📋 Reports
    </a>
</div>



