@model Proyecto1_1_1548_0877.Models.Procedures

@{
    ViewData["Title"] = "Create procedure";
}

<h1>Create Procedure</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <fieldset class="border p-3 mb-3 rounded bg-light">
                <legend class="w-auto px-2 h5">👤 Owner Information</legend>

                <div class="form-group mb-3">
                    <label asp-for="IdCustomer" class="control-label fw-bold">Owner</label>
                    <select asp-for="IdCustomer" id="ddlCustomers" class="form-control" asp-items="@ViewBag.Customers" required>
                        <option value="">-- Select a customer --</option>
                    </select>
                    <span asp-validation-for="IdCustomer" class="text-danger"></span>
                    <small class="form-text text-muted">
                        Select the customer who owns the pet.
                        <a asp-controller="Customers" asp-action="Create" target="_blank">
                            Not registered yet? Create a new customer
                        </a>
                    </small>
                </div>
            </fieldset>

            <!-- Pet name -->
            <div class="form-group">
                <label asp-for="PetId" class="control-label"></label>
                <select asp-for="PetId" id="ddlPets" class="form-control">
                    <option value="">-- Select pet --</option>
                </select>
                <span asp-validation-for="PetId" class="text-danger"></span>
            </div>

            <!-- Procedure Type Table -->
            <h4>Procedure Types</h4>
            <table class="table table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Type</th>
                        <th>Description</th>
                        <th>Base price (₡)</th>
                        <th>Select</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>Consultation</td><td>Pet consultation</td><td>15000</td><td><input type="radio" asp-for="ProcedureType" value="Consultation" data-precio="15000" /></td></tr>
                    <tr><td>Consultation during special hours</td><td>Consultation after 18:00 hrs or on weekends/holidays</td><td>17000</td><td><input type="radio" asp-for="ProcedureType" value="ConsultationSpecialHours" data-precio="17000" /></td></tr>
                    <tr><td>Neutering 0-5 kg</td><td>Neutered pet weighing 0-5 kg</td><td>35000</td><td><input type="radio" asp-for="ProcedureType" value="Neutering_0_5" data-precio="35000" /></td></tr>
                    <tr><td>Neutering 5-10 kg</td><td>Neutered pet weighing 5-10 kg</td><td>45000</td><td><input type="radio" asp-for="ProcedureType" value="Neutering_5_10" data-precio="45000" /></td></tr>
                    <tr><td>Neutering 10-20 kg</td><td>Neutered pet weighing 10-20 kg</td><td>55000</td><td><input type="radio" asp-for="ProcedureType" value="Neutering_10_20kg" data-precio="55000" /></td></tr>
                    <tr><td>Neutering 20-30 kg</td><td>Neutered pet weighing 20-30 kg</td><td>80000</td><td><input type="radio" asp-for="ProcedureType" value="Neutering_20_30kg" data-precio="80000" /></td></tr>
                    <tr><td>Neutering 30-50 kg</td><td>Neutered pet weighing 30-50 kg</td><td>100000</td><td><input type="radio" asp-for="ProcedureType" value="Neutering_30_50kg" data-precio="100000" /></td></tr>
                    <tr><td>Minor surgery</td><td>Cost per kilo of patient weight</td><td>15000</td><td><input type="radio" asp-for="ProcedureType" value="MinorSurgery" data-precio="15000" /></td></tr>
                    <tr><td>Surgery</td><td>Cost per kilo of patient weight</td><td>25000</td><td><input type="radio" asp-for="ProcedureType" value="Surgery" data-precio="25000" /></td></tr>
                    <tr><td>Grooming small</td><td>Full grooming for a small pet</td><td>15000</td><td><input type="radio" asp-for="ProcedureType" value="Grooming_Small" data-precio="15000" /></td></tr>
                    <tr><td>Grooming medium</td><td>Full grooming for a medium pet</td><td>20000</td><td><input type="radio" asp-for="ProcedureType" value="Grooming_Medium" data-precio="20000" /></td></tr>
                    <tr><td>Grooming big</td><td>Full grooming for a big pet</td><td>25000</td><td><input type="radio" asp-for="ProcedureType" value="Grooming_Big" data-precio="25000" /></td></tr>
                    <tr><td>Grooming extra big</td><td>Full grooming for an extra big pet</td><td>35000</td><td><input type="radio" asp-for="ProcedureType" value="Grooming_ExtraBig" data-precio="35000" /></td></tr>
                    <tr><td>Annual vaccines</td><td>Annual vaccines for a pet</td><td>40000</td><td><input type="radio" asp-for="ProcedureType" value="AnnualVaccines" data-precio="40000" /></td></tr>
                </tbody>
            </table>

            <!-- Weight -->
            <div class="form-group">
                <label asp-for="Weight" class="control-label"></label>
                <input asp-for="Weight" class="form-control" id="Weight" />
                <span asp-validation-for="Weight" class="text-danger"></span>
            </div>

            <!-- Base Price -->
            <div class="form-group">
                <label asp-for="BasePrice" class="control-label"></label>
                <input asp-for="BasePrice" class="form-control" readonly id="BasePrice" />
                <span asp-validation-for="BasePrice" class="text-danger"></span>
            </div>

            <!-- VAT -->
            <div class="form-group">
                <label asp-for="VAT" class="control-label"></label>
                <input asp-for="VAT" class="form-control" readonly id="VAT" />
            </div>

            <!-- Total Price -->
            <div class="form-group">
                <label asp-for="TotalPrice" class="control-label"></label>
                <input asp-for="TotalPrice" class="form-control" readonly id="TotalPrice" />
            </div>

            <!-- Status -->
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-control" asp-items="ViewBag.ProcedureStatus">
                    <option value="">-- Select status --</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <!-- Submit button -->
            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div class="mt-2">
    <a asp-action="IndexProcedures" class="btn btn-secondary">Back to list</a>
</div>

<!-- Scripts -->
@section Scripts {
    <script>
        // Script to calculate prices and VAT
        document.addEventListener("DOMContentLoaded", function () {
            const radios = document.querySelectorAll('input[name="ProcedureType"]');
            const priceInput = document.getElementById('BasePrice');
            const vatInput = document.getElementById('VAT');
            const totalInput = document.getElementById('TotalPrice');
            const weightInput = document.getElementById('Weight');

            function updatePrices() {
                let price = parseFloat(priceInput.value) || 0;
                let weight = parseFloat(weightInput.value) || 0;

                const type = document.querySelector('input[name="ProcedureType"]:checked')?.value;
                if (type === "MinorSurgery" || type === "Surgery") {
                    price *= weight;
                }

                priceInput.value = price;
                const vat = price * 0.13;
                vatInput.value = vat.toFixed(2);
                totalInput.value = (price + vat).toFixed(2);
            }

            radios.forEach(radio => {
                radio.addEventListener('change', function () {
                    const price = parseFloat(this.getAttribute('data-precio')) || 0;
                    priceInput.value = price;
                    updatePrices();
                });
            });

            weightInput.addEventListener('input', updatePrices);
        });

        // Script to load pets by customer
        $(document).ready(function () {
            $('#ddlCustomers').change(function () {
                var idCustomer = $(this).val();
                var $ddlPets = $('#ddlPets');

                $ddlPets.empty();
                $ddlPets.append('<option value="">Loading...</option>');

                if (idCustomer) {
                    $.ajax({
                        url: '/Procedures/GetPetsByCustomer',
                        type: 'GET',
                        data: { idCustomer: idCustomer },
                        success: function (data) {
                            $ddlPets.empty();
                            $ddlPets.append('<option value="">-- Select pet --</option>');
                            $.each(data, function (i, pet) {
                                $ddlPets.append('<option value="' + pet.value + '">' + pet.text + '</option>');
                            });
                        },
                        error: function () {
                            $ddlPets.empty();
                            $ddlPets.append('<option value="">Error loading pets</option>');
                        }
                    });
                } else {
                    $ddlPets.empty();
                    $ddlPets.append('<option value="">Select a customer first</option>');
                }
            });
        });
    </script>
}
