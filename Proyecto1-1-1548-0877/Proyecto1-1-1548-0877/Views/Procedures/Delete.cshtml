@model Proyecto1_1_1548_0877.Models.Procedures

@{
    ViewData["Title"] = "Delete Procedure";
}

<h1>Delete Procedure</h1>

<h3>Are you sure you want to delete this procedure?</h3>

<div>
    <h4>Procedure</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Id)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Id)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.IdCustomer)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.IdCustomer)</dd>

        <dt class="col-sm-2">Pet name</dt>
        <dd class="col-sm-10">@Model.Pets?.PetName</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ProcedureType)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ProcedureType)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Weight)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Weight)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.BasePrice)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.BasePrice)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.VAT)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.VAT)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.TotalPrice)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.TotalPrice)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Status)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Status)</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post" asp-route-id="@Model.Id">
        @Html.AntiForgeryToken()
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="IndexProcedures" class="btn btn-secondary">Back</a>
    </form>
</div>
