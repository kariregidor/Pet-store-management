@model Proyecto1_1_1548_0877.Models.Mascotas

@{
    ViewData["Title"] = "Eliminar Mascota";
}

<h1>Eliminar</h1>

<h3>¿Está seguro de que desea eliminar esta mascota?</h3>

<!-- Mostrar mensaje de error si existe -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

<div>
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.MascotaId</dd>

        <dt class="col-sm-2">Dueño</dt>
        <dd class="col-sm-10">
            @(Model.Cliente != null ? $"{Model.Cliente.IdCliente} / {Model.Cliente.NombreCompleto}" : "N/A")
        </dd>

        <dt class="col-sm-2">NombreMascota</dt>
        <dd class="col-sm-10">@Model.NombreMascota</dd>

        <dt class="col-sm-2">Especie</dt>
        <dd class="col-sm-10">@Model.Especie</dd>

        <dt class="col-sm-2">Raza</dt>
        <dd class="col-sm-10">@Model.Raza</dd>

        <dt class="col-sm-2">Edad</dt>
        <dd class="col-sm-10">@Model.Edad</dd>

        <dt class="col-sm-2">Color</dt>
        <dd class="col-sm-10">@Model.Color</dd>

        <dt class="col-sm-2">Última Fecha Atención</dt>
        <dd class="col-sm-10">@Model.UltimaFechaAtencion?.ToString("dd-MM-yyyy")</dd>

        <dt class="col-sm-2">Teléfono dueño</dt>
        <dd class="col-sm-10">@Model.TelefonoDueno</dd>

        <dt class="col-sm-2">Email dueño</dt>
        <dd class="col-sm-10">@Model.EmailDueno</dd>
    </dl>
    <form asp-action="Delete" asp-route-id="@Model.MascotaId" method="post">
        @Html.AntiForgeryToken()
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="IndexMascotas" class="btn btn-secondary">Regresar</a>
    </form>
</div>
