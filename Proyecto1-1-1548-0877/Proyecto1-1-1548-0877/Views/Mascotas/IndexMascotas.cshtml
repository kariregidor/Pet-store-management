@model IEnumerable<Proyecto1_1_1548_0877.Models.Mascotas>

@{
    ViewData["Title"] = "🐾 Mascotas";
}

<h1>🐾 Mascotas</h1>

<p>
    <a asp-action="Create" class="btn btn-info">Crear Mascota</a>
    <a asp-action="Buscar" class="btn btn-info">🔍 Buscar Mascotas</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MascotaId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdCliente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NombreMascota)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Especie)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Raza)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Edad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Color)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UltimaFechaAtencion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TelefonoDueno)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmailDueno)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.MascotaId)
                </td>
                <td>
                    @(item.Cliente != null ? item.Cliente.IdCliente.ToString() : item.IdCliente.ToString())
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NombreMascota)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Especie)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Raza)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Edad)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Color)
                </td>
                <td>
                    @item.UltimaFechaAtencion?.ToString("dd-MM-yyyy")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TelefonoDueno)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmailDueno)
                </td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = item.MascotaId }) |
                    @Html.ActionLink("Eliminar", "Delete", new { id = item.MascotaId })
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Regresar</a>
