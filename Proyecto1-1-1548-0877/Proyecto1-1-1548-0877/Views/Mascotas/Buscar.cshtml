@model IEnumerable<Proyecto1_1_1548_0877.Models.Mascotas>

@{
    ViewData["Title"] = "Buscar";
}

<h1>Buscar</h1>

<form asp-action="Buscar" method="get" class="mb-3">
    <div class="row">
        <div class="col-md-2">
            <input type="text" name="id" class="form-control" placeholder="Id" />
        </div>
        <div class="col-md-2">
            <input type="text" name="cedulaDueno" class="form-control" placeholder="Cédula / Nombre" />
        </div>
        <div class="col-md-2">
            <input type="text" name="nombreMascota" class="form-control" placeholder="NombreMascota" />
        </div>
        <div class="col-md-2">
            <select name="especie" class="form-control">
                <option value="">-- Especie --</option>
                @foreach (var esp in ViewBag.Especie)
                {
                    <option value="@esp.Value">@esp.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <input type="text" name="raza" class="form-control" placeholder="Raza" />
        </div>
        <div class="col-md-2">
            <input type="text" name="edad" class="form-control" placeholder="Edad" />
        </div>
        <div class="col-md-2">
            <input type="text" name="color" class="form-control" placeholder="Color" />
        </div>
        <div class="col-md-2">
            <input type="date" name="ultimaFechaAtencion" class="form-control" />
        </div>
        <div class="col-md-2">
            <input type="text" name="telefonoDueno" class="form-control" placeholder="Teléfono del dueño" />
        </div>
        <div class="col-md-2">
            <input type="text" name="emailDueno" class="form-control" placeholder="Email del dueño" />
        </div>
    </div>
    <div class="mt-2">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="IndexMascotas" class="btn btn-secondary">Atrás</a>
    </div>
</form>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Id</th>
            <th>Dueño (Cédula / Nombre)</th>
            <th>NombreMascota</th>
            <th>Especie</th>
            <th>Raza</th>
            <th>Edad</th>
            <th>Color</th>
            <th>Última fecha de atención</th>
            <th>Teléfono del dueño</th>
            <th>Email del dueño</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var mascotas in Model)
        {
            <tr>
                <td>@mascotas.MascotaId</td>
                <td>@(mascotas.Cliente != null ? mascotas.Cliente.IdCliente.ToString() : mascotas.IdCliente.ToString())</td>
                <td>@mascotas.NombreMascota</td>
                <td>@mascotas.Especie</td>
                <td>@mascotas.Raza</td>
                <td>@mascotas.Edad</td>
                <td>@mascotas.Color</td>
                <td>@mascotas.UltimaFechaAtencion?.ToString("dd-MM-yyyy")</td>
                <td>@mascotas.TelefonoDueno</td>
                <td>@mascotas.EmailDueno</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@mascotas.MascotaId" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@mascotas.MascotaId" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>