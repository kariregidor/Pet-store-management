@model Proyecto1_1_1548_0877.Models.Mascotas

@{
    ViewData["Title"] = "Actualizar";
}

<h1>Actualizar Mascota</h1>

<h4>Mascota</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="MascotaId" />

            <fieldset class="border p-3 mb-3 rounded bg-light">
                <legend class="w-auto px-2 h5">👤 Información del Dueño</legend>

                <div class="form-group mb-3">
                    <label asp-for="IdCliente" class="control-label fw-bold">Dueño</label>
                    <select asp-for="IdCliente" class="form-control" asp-items="@ViewBag.Clientes" required>
                        <option value="">-- Seleccione un cliente --</option>
                    </select>
                    <span asp-validation-for="IdCliente" class="text-danger"></span>
                    <small class="form-text text-muted">
                        Seleccione el cliente dueño de la mascota.
                        <a asp-controller="Clientes" asp-action="Create" target="_blank">
                            ¿No está registrado? Crear nuevo cliente
                        </a>
                    </small>
                </div>
            </fieldset>

            <div class="form-group mb-3">
                <label asp-for="NombreMascota" class="control-label"></label>
                <input asp-for="NombreMascota" class="form-control" />
                <span asp-validation-for="NombreMascota" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Especie" class="control-label"></label>
                <select asp-for="Especie" class="form-control" asp-items="@ViewBag.Especie">
                    <option value="">-- Seleccione especie --</option>
                </select>
                <span asp-validation-for="Especie" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Raza" class="control-label"></label>
                <input asp-for="Raza" class="form-control" />
                <span asp-validation-for="Raza" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Edad" class="control-label"></label>
                <input asp-for="Edad" class="form-control" />
                <span asp-validation-for="Edad" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Color" class="control-label"></label>
                <input asp-for="Color" class="form-control" />
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="UltimaFechaAtencion" class="control-label"></label>
                <input asp-for="UltimaFechaAtencion" class="form-control" type="date" />
                <span asp-validation-for="UltimaFechaAtencion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TelefonoDueno" class="control-label"></label>
                <input asp-for="TelefonoDueno" class="form-control" />
                <span asp-validation-for="TelefonoDueno" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EmailDueno" class="control-label"></label>
                <input asp-for="EmailDueno" class="form-control" />
                <span asp-validation-for="EmailDueno" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="IndexMascotas" class="btn btn-secondary">Regresar</a>
            </div>
        </form>
    </div>
</div>
