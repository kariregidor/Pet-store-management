@model Proyecto1_1_1548_0877.Models.Pets

@{
    ViewData["Title"] = "Delete Pet";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this pet?</h3>

<!-- Show error message if any -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

<div>
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.PetId</dd>

        <dt class="col-sm-2">Owner</dt>
        <dd class="col-sm-10">
            @(Model.Customer != null ? $"{Model.Customer.IdCustomer} / {Model.Customer.Name}" : "N/A")
        </dd>

        <dt class="col-sm-2">Pet name</dt>
        <dd class="col-sm-10">@Model.PetName</dd>

        <dt class="col-sm-2">Animal species</dt>
        <dd class="col-sm-10">@Model.AnimalSpecies</dd>

        <dt class="col-sm-2">Breed</dt>
        <dd class="col-sm-10">@Model.Breed</dd>

        <dt class="col-sm-2">Age</dt>
        <dd class="col-sm-10">@Model.Age</dd>

        <dt class="col-sm-2">Color</dt>
        <dd class="col-sm-10">@Model.Color</dd>

        <dt class="col-sm-2">Last date of service</dt>
        <dd class="col-sm-10">@Model.LastServiceDate?.ToString("dd-MM-yyyy")</dd>

        <dt class="col-sm-2">Owner's phone</dt>
        <dd class="col-sm-10">@Model.PhoneOwner</dd>

        <dt class="col-sm-2">Owner's email</dt>
        <dd class="col-sm-10">@Model.EmailOwner</dd>
    </dl>
    <form asp-action="Delete" asp-route-id="@Model.PetId" method="post">
        @Html.AntiForgeryToken()
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="IndexPets" class="btn btn-secondary">Back</a>
    </form>
</div>
