@model IEnumerable<Proyecto1_1_1548_0877.Models.Cliente>

@{
    ViewData["Title"] = "Buscar";
}

<h1>Buscar</h1>

<form asp-action="Buscar" method="get" class="mb-3">
    <div class="row">
        
        <div class="col-md-2">
            <input type="text" name="cedulaDueno" class="form-control" placeholder="CedulaDueno" />
        </div>
        <div class="col-md-2">
            <input type="text" name="nombreCompleto" class="form-control" placeholder="NombreCompleto" />
        </div>
        <div class="col-md-2">
            <input type="text" name="provincia" class="form-control" placeholder="Provincia" />
        </div>
        <div class="col-md-2">
            <input type="text" name="canton" class="form-control" placeholder="Canton" />
        </div>
        <div class="col-md-2">
            <input type="text" name="distrito" class="form-control" placeholder="Distrito" />
        </div>
        <div class="col-md-2">
            <input type="text" name="direccionExacta" class="form-control" placeholder="DireccionExacta" />
        </div>
        <div class="col-md-2">
            <input type="text" name="telefono" class="form-control" placeholder="Telefono" />
        </div>


        <div class="col-md-2">
            <select name="PreferenciaContacto" class="form-control">
                <option value="">-- Prefencia contacto --</option>
                @foreach (var esp in ViewBag.PreferenciaContacto)
                {
                    <option value="@esp.Value">@esp.Text</option>
                }
            </select>
        </div>
        


    </div>

    <div class="mt-2">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="IndexClientes" class="btn btn-secondary">Atras</a>
    </div>
</form>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre completo</th>
            <th>Provincia</th>
            <th>Cantón</th>
            <th>Distrito</th>
            <th>Dirección exacta</th>
            <th>Teléfono</th>
            <th>Preferencia de contacto</th> 
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var clientes in Model)
        {
            <tr>
                <td>@clientes.IdCliente</td>
                <td>@clientes.NombreCompleto</td>
                <td>@clientes.Provincia</td>
                <td>@clientes.Canton</td>
                <td>@clientes.Distrito</td>
                <td>@clientes.DireccionExacta</td>
                <td>@clientes.Telefono</td>
                <td>@clientes.PreferenciaContacto</td>
               

             

                <td>
                    <a asp-action="Edit" asp-route-id="@clientes.IdCliente" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@clientes.IdCliente" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
